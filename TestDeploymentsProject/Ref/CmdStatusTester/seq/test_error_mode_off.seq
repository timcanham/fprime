; Test ERROR_MODE OFF directive
; This sequence demonstrates continuing execution even when commands fail

; Turn off error mode - sequence will continue on command failures
ERROR_MODE 0

; Execute a successful command
R00:00:00 Ref.cmdStatusTester.TEST_CMD_SUCCESS 100 1.0 true

; Execute a failing command - normally would abort, but ERROR_MODE is OFF
R00:00:05 Ref.cmdStatusTester.TEST_CMD_FAIL 200 -20 "should_not_abort"

; This SHOULD execute because ERROR_MODE is OFF
R00:00:10 Ref.cmdStatusTester.TEST_CMD_SUCCESS 300 3.0 false

; Another failing command
R00:00:15 Ref.cmdStatusTester.TEST_CMD_FAIL 400 -40 "still_not_abort"

; This should also execute
R00:00:20 Ref.cmdStatusTester.TEST_CMD_SUCCESS 500 5.0 true

; Exit successfully
EXIT 0
